# Copy this file to .env for local use. Replace the placeholder passwords.
POSTGRES_DB=local_review
POSTGRES_USER=local_review
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me_for_local_development
REDIS_PORT=6379

BACKEND_PORT=8080
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
TOKEN_TTL=30m
CODE_TTL=5m
ORDER_STREAM_MAX_RETRIES=3
ORDER_STREAM_KEY=stream.orders
ORDER_STREAM_GROUP=order-group

# Optional JVM proxy arguments for Maven downloads during Docker builds.
MAVEN_OPTS=
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
